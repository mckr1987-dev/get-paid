{
  "_version": "1.90.0",
  "sap.app": {
    "id": "smartcollect",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.34.0",
      "toolsId": "0b763148-42ad-4b46-a9e6-189a59c2b6a3"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/smartcollect/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.154.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "smartcollect.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "OpenInvoicesList",
          "target": "OpenInvoicesList"
        },
        {
          "pattern": "OpenInvoices({key}):?query:",
          "name": "OpenInvoicesObjectPage",
          "target": "OpenInvoicesObjectPage"
        }
      ],
      "targets": {
        "OpenInvoicesList": {
          "type": "Component",
          "id": "OpenInvoicesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
          "settings": {
            "contextPath": "/OpenInvoices",
            "variantManagement": "Page",
            "navigation": {
              "OpenInvoices": {
                "detail": {
                  "route": "OpenInvoicesObjectPage"
                }
              }
            },
            "controlConfiguration": {
              "@com.sap.vocabularies.UI.v1.LineItem": {
                "actions": {
                  "sendReminderPreview": {
                    "press": "smartcollect.ext.ReminderHandler.onSendReminder",
                    "text": "Send reminder",
                    "requiresSelection": true
                  }
                }
              }
            }
          }
          }
        },
        "OpenInvoicesObjectPage": {
          "type": "Component",
          "id": "OpenInvoicesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/OpenInvoices"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
