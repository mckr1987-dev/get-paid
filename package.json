{
  "name": "get-paid",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-smartcollect": "cds watch --open smartcollect/index.html?sap-ui-xx-viewCache=false --livereload false",
    "test": "node --test \"test/**/*.test.js\""
  },
  "private": true,
  "cds": {
    "reminder": { "mailMode": "log" },
    "requires": {
      "ZFI_OPEN_ITEMS_SRV": {
        "kind": "odata",
        "model": "srv/external/ZFI_OPEN_ITEMS_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4_ONPREM",
            "path": "/sap/opu/odata/sap/ZFI_OPEN_ITEMS_SRV"
          }
        }
      },
      "ZCUSTOMER_CONTACT_SRV": {
        "kind": "odata",
        "model": "srv/external/ZCUSTOMER_CONTACT_SRV",
        "[production]": {
          "credentials": {
            "destination": "S4_ONPREM",
            "path": "/sap/opu/odata/sap/ZCUSTOMER_CONTACT_SRV"
          }
        }
      },
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "viewer": { "password": "viewer", "roles": ["Viewer"] },
            "agent":  { "password": "agent",  "roles": ["CollectionsAgent"] }
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/smartcollect"
  ]
}